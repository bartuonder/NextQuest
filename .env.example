# Copy to .env and fill in. Everything here has a working default except the
# OpenAI key, which is what actually powers the recommendations.

# --- Application ---
APP_NAME=NextQuest
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./nextquest.db
# Postgres (what docker-compose uses):
# DATABASE_URL=postgresql+psycopg://nextquest:nextquest@db:5432/nextquest

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- OpenAI / LangChain ---
# OPENAI_KEY works as well, if that is how your key is already stored.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.8
OPENAI_TIMEOUT=60

# --- LangSmith tracing (optional; leave empty to turn it off) ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nextquest

# --- CORS (comma separated, * allows everything) ---
CORS_ORIGINS=*
